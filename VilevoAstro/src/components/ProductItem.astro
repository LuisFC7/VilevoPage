---
import { Image } from "astro:assets";
import QuantityCounter from "./QuantityCounter.tsx";

const { imgSrc, altText, productName, price, showSize, id } = Astro.props;

import "../styles/Merch.css";
---

<div class="merch-description" data-product-id={id}>
  <div class="merch-img">
    <Image class="merch-img" src={imgSrc} alt={altText} />
  </div>

  <div class="merch-info">
    <div class="merch-exp">
      <h3>{productName}</h3>
      <div class="merch-price">${price}</div>
    </div>

    <div class="merch-controls">
      <!-- Selección de Talla -->
      {
        showSize && (
          <div class="control-group">
            <label for={`talla-${id}`}>Talla:</label>
            <select id={`talla-${id}`} name="talla" class="talla-select">
              <option value="">Selecciona una talla</option>
              <option value="S">S</option>
              <option value="M">M</option>
              <option value="L">L</option>
              <option value="XL">XL</option>
            </select>
          </div>
        )
      }

      <!-- Contador React (Astro Island) -->
      <div class="control-group">
        <QuantityCounter
          client:load
          productId={id}
          initialQuantity={1}
          onQuantityChange={(quantity) => {
            const productElement = document.querySelector(
              `[data-product-id="${id}"]`
            );
            if (productElement) {
              // Solución definitiva para dataset
              const htmlElement = productElement as unknown as HTMLElement;
              htmlElement.dataset.quantity = quantity.toString();
            }
          }}
        />
      </div>

      <!-- Botón Añadir al Carrito -->
      <button class="add-to-cart-btn" data-product-id={id}>
        Añadir al carrito <i class="fas fa-shopping-cart"></i>
      </button>
    </div>
  </div>
</div>

<script is:inline>
  // Evita registrar el listener múltiples veces
  if (!window.__addToCartListenerRegistered) {
    window.__addToCartListenerRegistered = true;

    document.addEventListener("click", function (e) {
      function isHTMLElement(node) {
        return node && node.nodeType === Node.ELEMENT_NODE;
      }

      var target = e.target;
      if (!isHTMLElement(target)) return;

      if (target.classList.contains('add-to-cart-btn')) {
        e.preventDefault();
        e.stopPropagation();

        var productId = target.getAttribute('data-product-id');
        var productElement = target.closest('.merch-description');

        if (productId && productElement) {
          var quantityInput = productElement.querySelector('.cantidad-input');
          var quantity = quantityInput ? parseInt(quantityInput.value) || 1 : 1;

          const tallaSelect = productElement.querySelector('.talla-select');
          const tallaValue = tallaSelect?.value ?? '';

          if (tallaSelect && tallaValue === "") {
            alert('Por favor selecciona una talla');
            return;
          }

          var productData = {
            id: productId,
            name: productElement.querySelector('h3')?.textContent || '',
            price: parseFloat(
              (productElement.querySelector('.merch-price')?.textContent || '0')
                .replace('$', '')
            ),
            size: tallaValue || 'N/A',
            quantity: quantity
          };

          window.dispatchEvent(new CustomEvent('addToCart', { detail: productData }));
          window.dispatchEvent(new CustomEvent('resetCounter', { detail: { productId } }));
        }
      }
    });
  }
</script>
