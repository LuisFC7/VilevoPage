---
import '../styles/components/HeroStyle.css';
import '../styles/global.css';
---

<section class="hero">
    <div class="hero-content">
        <div class="hero-text">
            <!-- <h1>VILEVO</h1> -->
            <img src="../../img/VilevoLogo.jpg" alt="Vilevo Logo">
            <h2>POST PUNK desde Neza</h2>
        </div>

        <div class="hero-cont-img">
            <img class="hero-img" src="../../img/VilevoHome2.jpg" alt="Vilevo Home">
        </div>

        <div class="hero-button">
            <button class="btn" onclick="window.open('https://open.spotify.com', '_blank')">
              Escúchanos en Spotify
            </button>
        </div>
        
    </div>
</section>
