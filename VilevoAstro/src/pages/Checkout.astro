---
import Layout from '../layouts/Layout.astro';
import CheckoutCart from '../components/CheckoutCart';
import '../styles/Checkout.css';
---

<Layout>
  <div class="checkout-page">
    <h2>Formulario de Pago</h2>

    <!-- Componente React para leer del localStorage -->
    <CheckoutCart client:load />

    <!-- Formulario Astro puro -->
    <form method="POST" action="/api/pagar" class="checkout-form">
      <label>
        Nombre completo:
        <input type="text" name="nombre_completo" placeholder="Nombre Completo" required />
      </label>

      <label>
        Domicilio:
        <input type="text" name="domicilio" placeholder="Domicilio" required />
      </label>

      <label>
        Número:
        <input type="text" name="numero" placeholder="Número interior o exterior" required />
      </label>

      <label>
        Colonia:
        <input type="text" name="colonia" placeholder="Colonia" required />
      </label>

      <label>
        Código Postal:
        <input type="text" name="codigo_postal" placeholder="Código Postal" required />
      </label>

      <label>
        País:
        <input type="text" name="País" placeholder="País" required />
      </label>

      <label>
        Ciudad o población:
        <input type="text" name="ciudad" placeholder="Ciudad o población" required />
      </label>

      <label>
        Alcaldía o Municipio:
        <input type="text" name="municipio" placeholder="Alcaldía o Municipio" required />
      </label>

      <label>
        Entidad federativa:
        <input type="text" name="entidad_federativa" placeholder="Entidad federativa" required />
      </label>

      <label>
        Número telefónico:
        <input type="tel" name="telefono" placeholder="Número telefónico" required />
      </label>

      <!-- <button type="submit">Enviar Pedido</button> -->
      <button type="button" id="enviarPedido">Enviar Pedido</button>

    </form>
  </div>
</Layout>

<script>
  document.getElementById('enviarPedido').addEventListener('click', function () {
    const form = document.querySelector('.checkout-form');

    const nombre = form.nombre_completo.value;
    const domicilio = form.domicilio.value;
    const numero = form.numero.value;
    const colonia = form.colonia.value;
    const cp = form.codigo_postal.value;
    const pais = form.País.value;
    const ciudad = form.ciudad.value;
    const municipio = form.municipio.value;
    const entidad = form.entidad_federativa.value;
    const telefono = form.telefono.value;

    // Leer productos desde cartData
    let productos = [];
    try {
      const data = localStorage.getItem("cartData");
      productos = JSON.parse(data) || [];
    } catch (e) {
      console.error("Error leyendo cartData:", e);
    }

    // Detalle del carrito
    let detalleProductos = productos.map(p => 
      `🛍️ ${p.name} (Talla: ${p.size}) x${p.quantity} - $${p.price * p.quantity}`
    ).join('\n');

    // Total
    const total = productos.reduce((acc, p) => acc + (p.price * p.quantity), 0);

    if (productos.length === 0) {
      detalleProductos = '🛒 Carrito vacío';
    }

    // Mensaje completo
    const mensaje = `Hola, quiero hacer un pedido:
👤 Nombre: ${nombre}
🏠 Dirección: ${domicilio}, Nº ${numero}, Col. ${colonia}, CP ${cp}
🏙️ Ciudad: ${ciudad}, Municipio: ${municipio}, ${entidad}, ${pais}
📞 Teléfono: ${telefono}

🧾 Productos:
${detalleProductos}

💵 Subtotal: $${total.toFixed(2)}`;

    // Tu número de WhatsApp (código país + número)
    const numeroWhatsApp = "525566230889";
    const url = `https://wa.me/${numeroWhatsApp}?text=${encodeURIComponent(mensaje)}`;
    window.open(url, '_blank');
  });
</script>
